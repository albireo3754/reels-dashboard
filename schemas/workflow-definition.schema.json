{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "entry": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "maxTransitions": {
      "default": 100,
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "steps": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "task",
              "review",
              "input"
            ]
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "skills": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "tools": {
            "default": [],
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "server": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "name": {
                  "type": "string",
                  "maxLength": 120,
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "required": [
                "server",
                "name",
                "purpose"
              ],
              "additionalProperties": false
            }
          },
          "inputs": {
            "default": [],
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "outputs": {
            "default": [],
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "completion": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "formFile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "on": {
            "type": "object",
            "properties": {
              "done": {
                "type": "string"
              },
              "pass": {
                "type": "string"
              },
              "revise": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "instruction",
          "skills",
          "tools",
          "inputs",
          "outputs",
          "completion",
          "on"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "id",
    "title",
    "entry",
    "maxTransitions",
    "steps"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "projects": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "content",
              "operation"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "dateBasis": {
            "type": "string",
            "enum": [
              "capture",
              "publication",
              "record"
            ]
          },
          "stage": {
            "type": "string",
            "enum": [
              "idea",
              "captured",
              "selected",
              "editing",
              "review",
              "done",
              "published"
            ]
          },
          "nextAction": {
            "type": "string",
            "maxLength": 2000
          },
          "publicURL": {
            "type": "string",
            "maxLength": 2048
          },
          "shared": {
            "type": "boolean"
          },
          "localNotes": {
            "type": "string",
            "maxLength": 4000
          },
          "resources": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "footage",
                    "final",
                    "cover",
                    "draft",
                    "document",
                    "folder"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "format": "starts_with",
                  "pattern": "^\\/.*"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "role",
                "path",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "production": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "number",
                "const": 1
              },
              "edits": {
                "maxItems": 500,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "video",
                        "card-news"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                }
              },
              "mergedIds": {
                "maxItems": 500,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "exports": {
                "maxItems": 2000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "edit": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "video",
                            "card-news"
                          ]
                        },
                        "id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        }
                      },
                      "required": [
                        "kind",
                        "id"
                      ],
                      "additionalProperties": false
                    },
                    "path": {
                      "type": "string",
                      "maxLength": 4096,
                      "format": "starts_with",
                      "pattern": "^\\/.*"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "draft",
                        "final",
                        "cover"
                      ]
                    },
                    "recordedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    }
                  },
                  "required": [
                    "id",
                    "edit",
                    "path",
                    "role",
                    "recordedAt"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "schemaVersion",
              "edits",
              "mergedIds",
              "exports"
            ],
            "additionalProperties": false
          },
          "outbound": {
            "type": "object",
            "properties": {
              "directory": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "format": "starts_with",
                "pattern": "^\\/.*"
              },
              "generation": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "files": {
                "maxItems": 99,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "final",
                        "cover",
                        "document"
                      ]
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "name",
                    "role",
                    "bytes",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "receiptPath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "format": "starts_with",
                "pattern": "^\\/.*"
              }
            },
            "required": [
              "directory",
              "generation",
              "files",
              "updatedAt"
            ],
            "additionalProperties": false
          },
          "publications": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "channel": {
                  "type": "string",
                  "enum": [
                    "instagram",
                    "naver-clip",
                    "blog",
                    "youtube"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "planned",
                    "draft",
                    "scheduled",
                    "published"
                  ]
                },
                "url": {
                  "type": "string",
                  "maxLength": 2048
                },
                "publishedAt": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "scheduledAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "long",
                    "shorts"
                  ]
                }
              },
              "required": [
                "channel",
                "status",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "pitches": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                },
                "channel": {
                  "type": "string",
                  "enum": [
                    "instagram",
                    "naver-clip",
                    "blog",
                    "youtube"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "hookFamily": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "coverHooks": {
                  "minItems": 1,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "captionHead": {
                  "type": "string",
                  "maxLength": 200
                },
                "basedOn": {
                  "default": [],
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "title",
                      "evidence"
                    ],
                    "additionalProperties": false
                  }
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "hypothesis": {
                  "type": "string",
                  "maxLength": 400
                },
                "effort": {
                  "type": "string",
                  "enum": [
                    "S",
                    "M",
                    "L"
                  ]
                },
                "readiness": {
                  "type": "string",
                  "enum": [
                    "ready",
                    "needs_edit",
                    "needs_user",
                    "hold"
                  ]
                },
                "asks": {
                  "default": [],
                  "maxItems": 6,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "rank": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 99
                },
                "decision": {
                  "default": "proposed",
                  "type": "string",
                  "enum": [
                    "proposed",
                    "picked",
                    "dropped"
                  ]
                },
                "updatedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                }
              },
              "required": [
                "id",
                "channel",
                "title",
                "hookFamily",
                "coverHooks",
                "basedOn",
                "source",
                "effort",
                "readiness",
                "asks",
                "decision",
                "updatedAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "date",
          "stage",
          "nextAction",
          "publicURL",
          "shared"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "updatedAt",
    "projects"
  ],
  "additionalProperties": false,
  "$id": "https://reels-dashboard.local/schemas/dashboard.schema.json",
  "title": "Production project dashboard",
  "description": "A dashboard contains production projects. Each project owns many video/card-news edits, linked resources and export versions. Cross-project ownership, alias uniqueness and export resource references are enforced by validateDashboard."
}

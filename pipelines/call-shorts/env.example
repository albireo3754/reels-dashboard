# ─────────────────────────────────────────────────────────────
# 여친 탐구생활 숏폼 파이프라인 — 설정 예시
#   cp pipelines/call-shorts/env.example pipelines/call-shorts/.env
#   값이 비면 src/config.ts 기본값이 쓰입니다.
#   (.env 는 커밋 금지. scripts/setup-mac.sh 가 없을 때만 만들어 줍니다)
# ─────────────────────────────────────────────────────────────

# ── 1. 경로 ──────────────────────────────────────────────
# 루트 (기본: ~/Library/Mobile Documents/com~apple~CloudDocs/여친탐구생활)
PIPELINE_ROOT=
# 아래 값은 루트 기준 기본 경로를 각각 덮어씁니다.
# INBOX_DIR=
# PROCESSED_DIR=
# FAILED_DIR=
# PROJECTS_DIR=
# OUTBOX_DIR=
# STATE_FILE=
# LOGS_DIR=
# CHARACTER_SHEET_DIR=
# BGM_PATH=
# SFX_DIR=
# FONTS_DIR=

# ── 2. 모델 API 키 ───────────────────────────────────────
# LLM_BACKEND=cli/auto 면 기획·대본은 설치된 claude/codex CLI 세션으로 돌아 키가 필요 없습니다.
# GEMINI_API_KEY 는 이미지 생성(illustrator)에 필요합니다 — 텍스트 CLI 로는 PNG 를 만들 수 없습니다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── 3. 모델 ─────────────────────────────────────────────
LLM_BACKEND=auto
# cli: 설치된 claude·codex CLI 세션만 사용 (없으면 키가 있어도 실패 — 과금 방지)
# api: REST API 만 사용 (ANTHROPIC_API_KEY / OPENAI_API_KEY 필요)
# auto: CLI 가 있으면 CLI, 없으면 API 키
# 비우면 PATH 에서 찾고, 경로를 고정하려면 절대경로를 넣습니다.
# CLAUDE_CLI_BIN=
# CODEX_CLI_BIN=
# 비우면 CLI 로그인 세션의 기본 모델을 씁니다(모델을 덮어쓰지 않음).
# CLAUDE_CLI_MODEL=
# CODEX_CLI_MODEL=
LLM_CLI_TIMEOUT_SEC=300

CLAUDE_MODEL=claude-sonnet-4-5
GPT_MODEL=gpt-5
IMAGE_MODEL=gemini-3-pro-image-preview
IMAGE_MODEL_FALLBACK=gpt-image-1
GEMINI_AUDIO_MODEL=gemini-2.5-flash

# 전사 백엔드: auto | whisperx | whisper | gemini | mock
TRANSCRIBE_BACKEND=auto
TRANSCRIBE_MODEL=large-v3
# 이미지 제공자: gemini | openai | mock
IMAGE_PROVIDER=gemini

# ── 4. 예산 가드 ─────────────────────────────────────────
DAILY_BUDGET_USD=2.0
# 첫 편은 캐릭터 시트 6장 + 7컷 ≈ $1.74 라서 2.5 로 둡니다(넘으면 멈춤)
MAX_IMAGE_USD=2.5
MAX_EPISODE_USD=2.5
# 2K 이미지 1장당 가격(추정): Nano Banana Pro 2K=0.134
IMAGE_PRICE_USD=0.134
# CLI 세션 호출은 $0 로 기록되고(종량 과금 없음) 위 상한을 소모하지 않습니다.

# ── 5. 감시자 ────────────────────────────────────────────
STABLE_SECONDS=20
POLL_INTERVAL_SEC=30
# copy(기본, 원본 보존) | move
ARCHIVE_MODE=copy
ALLOWED_EXTENSIONS=.m4a,.wav,.mp3,.flac,.aac,.caf,.ogg,.opus,.mp4,.mov

# ── 6. 화자 ──────────────────────────────────────────────
# true면 SPEAKER_00=여자, SPEAKER_01=남자로 가정하고 진행
AUTO_ACCEPT_SPEAKER_MAP=false

# ── 7. 자막·렌더 ─────────────────────────────────────────
SUBTITLE_FONT=Pretendard
HOOK_FONT=Noto Sans KR
COLOR_GIRL=#FF6B9D
COLOR_BOY=#4FC3F7
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
FPS=30
COVER_TIME_SEC=0.6
X264_PRESET=slow
X264_CRF=18
# FFMPEG_BIN=
# FFPROBE_BIN=

# ── 8. 마스킹 ────────────────────────────────────────────
# 대본·자막에서 항상 가릴 고유명사 (쉼표 구분)
# 비우면 정규식 7종만 검사합니다 — 체크리스트가 그 한계를 표시하고 실명·회사명은 사람이 확인합니다.
REDACTION_TERMS=

# ── 9. 기타 ──────────────────────────────────────────────
LOG_LEVEL=INFO
TZ_NAME=Asia/Seoul
